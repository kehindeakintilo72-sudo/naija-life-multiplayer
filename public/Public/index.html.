<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#10231d"><title>Naija Life — City Multiplayer</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
<style>
:root{--bg:#0b1512;--panel:#14231e;--line:#2b4439;--text:#f3f5e9;--muted:#aabbb0;--lime:#c8f169;--orange:#ffb36b;--red:#ff8f8f}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 80% 0%,#234435 0,transparent 35%),var(--bg);color:var(--text);font-family:system-ui,-apple-system,Segoe UI,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}.app{max-width:1250px;margin:auto;padding:18px}.top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:17px}.brand{display:flex;align-items:center;gap:10px;font-size:20px;font-weight:900}.logo{width:42px;height:42px;border-radius:14px;background:var(--lime);color:#10231d;display:grid;place-items:center;font-size:23px}.brand small{display:block;font-size:10px;color:var(--muted);letter-spacing:1.7px}.topright{display:flex;align-items:center;gap:10px;color:var(--muted);font-size:12px}.dot{display:inline-block;width:8px;height:8px;background:#66e6a0;border-radius:50%;margin-right:6px}.btn{border:1px solid var(--line);border-radius:11px;padding:10px 13px;background:#1b3028;color:var(--text);font-weight:800}.btn.primary{background:var(--lime);color:#12251b;border-color:var(--lime)}.btn.danger{color:#fff;background:#6a2929;border-color:#8e3c3c}.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:14px;margin-bottom:14px}.hero-copy,.hero-art,.panel{border:1px solid var(--line);border-radius:21px;background:linear-gradient(145deg,#172920,#101b17);overflow:hidden}.hero-copy{padding:28px}.eyebrow{font-size:11px;letter-spacing:1.8px;color:var(--lime);font-weight:900}.hero h1{font-size:clamp(35px,4.5vw,58px);line-height:.98;letter-spacing:-2.8px;margin:13px 0}.hero h1 span{color:var(--lime)}.hero p{color:var(--muted);line-height:1.65;max-width:500px}.hero-art{position:relative;min-height:225px;background:linear-gradient(#8fc8b3,#cbe3ad 53%,#d4a776 54%,#755347)}.sun{position:absolute;right:15%;top:12%;width:62px;height:62px;border-radius:50%;background:#fff0b0}.skyline{position:absolute;inset:25% 0 0;display:flex;align-items:end;gap:6px;padding:0 8px}.building{flex:1;background:#25453a;box-shadow:inset -7px 0 #17372f;border-radius:4px 4px 0 0;position:relative}.building:after{content:"";position:absolute;inset:10px 5px;background:repeating-linear-gradient(0deg,transparent 0 15px,#e4d4a2 16px 19px),repeating-linear-gradient(90deg,transparent 0 13px,#e4d4a2 14px 17px);opacity:.65}.building:nth-child(1){height:42%}.building:nth-child(2){height:70%}.building:nth-child(3){height:52%}.building:nth-child(4){height:88%}.building:nth-child(5){height:65%}.building:nth-child(6){height:45%}.building:nth-child(7){height:60%}.road{position:absolute;bottom:0;height:14%;left:0;right:0;background:#39483f;border-top:4px solid #efc47d}.road:after{content:"";position:absolute;top:50%;left:0;right:0;border-top:2px dashed #fff0c0}.grid{display:grid;grid-template-columns:1.1fr .9fr;gap:14px}.panel{padding:17px;margin-bottom:14px}.head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:13px}.head h2{font-size:17px;margin:0}.muted{font-size:12px;color:var(--muted);line-height:1.5}.tag{font-size:10px;color:var(--lime);background:#2b4032;padding:5px 8px;border-radius:99px;font-weight:900}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-bottom:14px}.stat{padding:13px;background:#14231e;border:1px solid var(--line);border-radius:15px}.stat small{display:block;color:var(--muted);font-size:11px;margin-bottom:6px}.stat strong{font-size:21px}.map{height:330px;border-radius:14px;overflow:hidden;border:1px solid var(--line);z-index:0}.leaflet-popup-content-wrapper,.leaflet-popup-tip{background:#14231e;color:var(--text)}.leaflet-control-attribution{font-size:9px!important}.location-row{display:flex;gap:7px;flex-wrap:wrap;margin-top:11px}.location-chip{padding:8px 10px;border-radius:10px;background:#1a2c23;color:var(--text);border:1px solid var(--line);font-size:12px}.location-chip.active{border-color:var(--lime);color:var(--lime)}.list{display:flex;flex-direction:column;gap:8px}.item{background:#1a2c23;border:1px solid #2b4439;border-radius:12px;padding:11px;display:flex;align-items:center;justify-content:space-between;gap:9px}.item strong{display:block;font-size:13px}.item small{display:block;color:var(--muted);font-size:11px;margin-top:3px}.item .actions{display:flex;gap:5px;flex-wrap:wrap}.item .btn{padding:7px 9px;font-size:11px}.chatbox{height:200px;overflow:auto;display:flex;flex-direction:column;gap:9px;padding:5px 0 10px}.msg{font-size:12px;line-height:1.5;overflow-wrap:anywhere}.msg strong{color:var(--lime)}.msg small{color:#71877a;margin-left:4px}.chatform{display:flex;gap:7px}.field{width:100%;min-width:0;background:#0d1914;color:var(--text);border:1px solid var(--line);border-radius:10px;padding:11px;outline:none}.field:focus{border-color:var(--lime)}.chatform .field{flex:1}.section{margin-top:12px;border-top:1px solid var(--line);padding-top:13px}.notice{font-size:12px;color:var(--orange);min-height:18px;margin-top:7px}.tabs{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:12px}.tab{border:1px solid var(--line);background:#1a2c23;color:var(--muted);padding:8px 11px;border-radius:10px;font-weight:800;font-size:12px}.tab.active{background:var(--lime);color:#14251b;border-color:var(--lime)}.hidden{display:none!important}.overlay{position:fixed;inset:0;background:#07100def;display:grid;place-items:center;padding:18px;z-index:20}.auth{width:100%;max-width:410px;background:#14231e;border:1px solid var(--line);border-radius:22px;padding:24px;box-shadow:0 20px 80px #0008}.auth h2{margin:0 0 7px;font-size:28px;letter-spacing:-1px}.auth p{color:var(--muted);font-size:13px;line-height:1.6}.auth .field{margin:5px 0}.auth .btn{width:100%;margin-top:8px}.foot{padding:17px 3px;color:var(--muted);font-size:11px;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}.toast{position:fixed;bottom:18px;left:50%;transform:translate(-50%,120px);opacity:0;background:var(--lime);color:#10231d;padding:12px 16px;border-radius:12px;font-weight:900;z-index:30;transition:.25s}.toast.show{transform:translate(-50%,0);opacity:1}
@media(max-width:850px){.hero,.grid{grid-template-columns:1fr}.hero-art{min-height:200px}}@media(max-width:550px){.app{padding:11px}.hero-copy{padding:22px}.stats{gap:6px}.stat{padding:10px}.stat strong{font-size:17px}.stat small{font-size:10px}.map{height:270px}.panel{padding:13px}.brand{font-size:17px}.topright{font-size:10px}.hero h1{letter-spacing:-2px}}
</style></head>
<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>
<script src="/city3d.js"></script>
<body>
<div class="app">
<header class="top"><div class="brand"><div class="logo">✳</div><div>NAIJA LIFE<small>YOUR CITY. YOUR STORY.</small></div></div><div class="topright"><span><span class="dot"></span><span id="connection">Connecting…</span></span><button class="btn" id="logoutBtn" hidden>Log out</button></div></header>
<section class="hero"><div class="hero-copy"><div class="eyebrow">🌴 MULTIPLAYER CITY LIFE</div><h1>Build a life.<br><span>Own your story.</span></h1><p>Work for your money, find a home, meet other players and explore a Lagos-inspired city. Your progress is saved to the database.</p><button class="btn primary" onclick="document.getElementById('mapPanel').scrollIntoView({behavior:'smooth'})">Explore the city ↓</button></div><div class="hero-art"><div class="sun"></div><div style="position:absolute;top:13px;left:13px;background:#10231ddd;border-radius:10px;padding:9px 11px;font-size:11px;font-weight:900">📍 LAGOS, NIGERIA · LIVE CITY</div><div class="skyline"><div class="building"></div><div class="building"></div><div class="building"></div><div class="building"></div><div class="building"></div><div class="building"></div><div class="building"></div></div><div class="road"></div></div></section>
<section class="stats"><div class="stat"><small>💸 Wallet</small><strong id="cash">₦—</strong></div><div class="stat"><small>⭐ Level</small><strong id="level">—</strong></div><div class="stat"><small>🏠 Properties</small><strong id="houseCount">—</strong></div></section>
<div class="grid"><main>
<section class="panel" id="mapPanel"><div class="head"><div><h2>Interactive city map</h2><div class="muted">Tap a marker or location to travel.</div></div><span class="tag">MAP</span></div><div id="map" class="map"></div><div class="location-row" id="locationChips"></div><div class="notice" id="mapNotice"></div></section>
<section class="panel"><div class="head"><div><h2>Jobs and hustle</h2><div class="muted">Work shifts to earn virtual money and experience.</div></div><span>💼</span></div><div class="list" id="jobs"></div></section>
<section class="panel"><div class="head"><div><h2>Find a home</h2><div class="muted">Save up and purchase a property.</div></div><span>🏠</span></div><div class="list" id="houses"></div><div class="section"><strong style="font-size:13px">Your properties</strong><div class="list" id="myHouses" style="margin-top:9px"></div></div></section>
</main><aside>
<section class="panel"><div class="head"><div><h2>Player profile</h2><div class="muted">Your saved game profile.</div></div><span class="tag" id="roleTag">PLAYER</span></div><div id="profile"></div></section>
<section class="panel"><div class="head"><div><h2>City chat</h2><div class="muted">Be kind. Reports are available for safety.</div></div><span class="tag">LIVE</span></div><div class="chatbox" id="chatbox"></div><form class="chatform" id="chatForm"><input class="field" id="chatInput" maxlength="240" placeholder="Say something nice…" autocomplete="off"><button class="btn primary">Send</button></form><div class="notice" id="chatNotice"></div></section>
<section class="panel"><div class="head"><h2>Friends & messages</h2><span>🤝</span></div><div class="tabs"><button class="tab active" data-tab="friendsView">Friends</button><button class="tab" data-tab="dmView">Private messages</button></div><div id="friendsView"><form id="friendForm" class="chatform"><input class="field" id="friendName" placeholder="Username to add" maxlength="20"><button class="btn primary">Add</button></form><div class="notice" id="friendNotice"></div><div class="list" id="friendsList" style="margin-top:10px"></div></div><div id="dmView" class="hidden"><select class="field" id="dmFriend"><option value="">Choose a friend</option></select><div class="chatbox" id="dmBox" style="margin-top:9px"></div><form id="dmForm" class="chatform"><input class="field" id="dmInput" maxlength="500" placeholder="Private message"><button class="btn primary">Send</button></form><div class="notice" id="dmNotice"></div></div></section>
<section class="panel"><div class="head"><div><h2>Safety centre</h2><div class="muted">Report players and mute them from your view.</div></div><span>🛡️</span></div><form id="reportForm"><input class="field" id="reportUser" type="number" placeholder="Player ID to report" required><textarea class="field" id="reportReason" placeholder="Reason for report" minlength="5" maxlength="300" required style="margin-top:7px;resize:vertical"></textarea><button class="btn" style="margin-top:7px">Submit report</button></form><div class="notice" id="reportNotice"></div><div id="adminPanel" class="hidden section"><div class="head"><h2>Admin moderation</h2><span class="tag">ADMIN</span></div><div class="list" id="reportsList"></div></div></section>
</aside></div><footer class="foot"><span><strong>✳ NAIJA LIFE V2</strong> · Original life-simulation starter</span><span>Demo economy · Please respect other players</span></footer></div>
<div class="overlay" id="authOverlay"><div class="auth"><div class="eyebrow">WELCOME TO THE CITY</div><h2 id="authTitle">Your next chapter.</h2><p id="authDescription">Create an account to save your progress and meet other players.</p><form id="authForm"><input class="field" id="authUsername" placeholder="Username (3–20 letters, numbers or _)" minlength="3" maxlength="20" pattern="[A-Za-z0-9_]{3,20}" required autocomplete="username"><input class="field" id="authPassword" type="password" placeholder="Password (at least 10 characters)" minlength="10" maxlength="128" required autocomplete="new-password"><button class="btn primary" id="authSubmit">Create account</button></form><button class="btn" id="switchAuth" style="width:100%;margin-top:8px">I already have an account — log in</button><div class="notice" id="authNotice"></div><p style="font-size:11px">Use a unique password. This is a demo project; never reuse your email or banking password.</p></div></div><div class="toast" id="toast"></div>
<script src="/socket.io/socket.io.js"></script><script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
const $=id=>document.getElementById(id);let user=null,loginMode=false,world=null,socket=null,map=null,markers={},selectedDm=null,friends=[];
const places=[{name:"Yaba",lat:6.5158,lng:3.3781,emoji:"🏘️"},{name:"Balogun Market",lat:6.4549,lng:3.3908,emoji:"🧺"},{name:"The Beach",lat:6.4215,lng:3.4305,emoji:"🏖️"},{name:"Tech Hub",lat:6.5244,lng:3.3792,emoji:"💻"},{name:"Freedom Park",lat:6.4531,lng:3.3947,emoji:"🎭"},{name:"Marina",lat:6.4527,lng:3.3982,emoji:"🌆"},{name:"Surulere",lat:6.4969,lng:3.3591,emoji:"🏢"},{name:"Lekki",lat:6.4474,lng:3.4702,emoji:"🏡"}];
let mutedIds=new Set();
function toast(s){$("toast").textContent=s;$("toast").classList.add("show");setTimeout(()=>$("toast").classList.remove("show"),2500)}
async function api(url,opts={}){const res=await fetch(url,{credentials:"same-origin",headers:{"Content-Type":"application/json",...(opts.headers||{})},...opts});let data={};try{data=await res.json()}catch{}if(!res.ok)throw new Error(data.error||"Request failed.");return data}
function setAuth(mode){loginMode=mode;$("authTitle").textContent=mode?"Welcome back.":"Your next chapter.";$("authDescription").textContent=mode?"Log in to return to your saved city life.":"Create an account to save your progress and meet other players.";$("authSubmit").textContent=mode?"Log in":"Create account";$("switchAuth").textContent=mode?"Need an account? Sign up":"I already have an account — log in";$("authPassword").setAttribute("autocomplete",mode?"current-password":"new-password");$("authNotice").textContent=""}
$("switchAuth").onclick=()=>setAuth(!loginMode);
$("authForm").onsubmit=async e=>{e.preventDefault();$("authNotice").textContent="Working…";try{const data=await api(loginMode?"/api/login":"/api/register",{method:"POST",body:JSON.stringify({username:$("authUsername").value.trim(),password:$("authPassword").value})});user=data.user;await boot()}catch(err){$("authNotice").textContent=err.message}};
$("logoutBtn").onclick=async()=>{if(socket)socket.disconnect();await api("/api/logout",{method:"POST",body:"{}"});user=null;world=null;$("authOverlay").classList.remove("hidden");$("logoutBtn").hidden=true;setAuth(true)};
async function boot(){try{const data=await api("/api/me");user=data.user;$("authOverlay").classList.add("hidden");$("logoutBtn").hidden=false;$("roleTag").textContent=user.role.toUpperCase();if(user.role==="admin")$("adminPanel").classList.remove("hidden");await loadWorld();connectSocket();if(!map)initMap();}catch(e){$("authOverlay").classList.remove("hidden")}}
async function loadWorld(){world=await api("/api/world");user=world.user;renderStats();renderJobs();renderHouses();renderProfile();renderChips();renderFriends();renderPresence(world.online);if(world.feed){$("chatbox").replaceChildren();world.feed.forEach(m=>addChat(m,false))}}
function renderStats(){$("cash").textContent="₦"+user.cash.toLocaleString("en-NG");$("level").textContent="Level "+user.level;$("houseCount").textContent=world.myHouses.length}
function renderProfile(){$("profile").innerHTML="";const row=document.createElement("div");row.className="item";const left=document.createElement("div");const strong=document.createElement("strong");strong.textContent="🧑🏽‍💻 "+user.username;const small=document.createElement("small");small.textContent="📍 "+user.location+" · "+user.xp+" XP";left.append(strong,small);const reportBtn=document.createElement("button");reportBtn.className="btn";reportBtn.textContent="Report ID: "+user.id;reportBtn.onclick=()=>{$("reportUser").value=user.id;toast("Your own ID is shown in your profile.")};row.append(left,reportBtn);$("profile").append(row);const note=document.createElement("p");note.className="muted";note.textContent="Account created "+new Date(user.created_at).toLocaleDateString();$("profile").append(note)}
function makeItem(title,sub,buttonText,handler,disabled=false){const row=document.createElement("div");row.className="item";const left=document.createElement("div");const s=document.createElement("strong");s.textContent=title;const sm=document.createElement("small");sm.textContent=sub;left.append(s,sm);const btn=document.createElement("button");btn.className="btn primary";btn.textContent=buttonText;btn.disabled=disabled;btn.onclick=handler;row.append(left,btn);return row}
function renderJobs(){$("jobs").replaceChildren();world.jobs.forEach(j=>$("jobs").append(makeItem(j.name,"₦"+j.pay.toLocaleString("en-NG")+" / shift · +"+j.xp+" XP","Work",async()=>{try{const r=await api(`/api/jobs/${j.id}/work`,{method:"POST",body:"{}"});user=r.user;renderStats();renderProfile();toast(r.message)}catch(e){toast(e.message)}})))}
function renderHouses(){$("houses").replaceChildren();world.houses.forEach(h=>$("houses").append(makeItem(h.name,h.location+" · ₦"+h.price.toLocaleString("en-NG"),h.owned?"Owned":"Buy",async()=>{try{const r=await api(`/api/houses/${h.id}/buy`,{method:"POST",body:"{}"});user=r.user;toast(r.message);await loadWorld()}catch(e){toast(e.message)}},!!h.owned)));$("myHouses").replaceChildren();if(!world.myHouses.length){$("myHouses").innerHTML='<div class="muted">No properties yet. Work shifts to save up.</div>'}else world.myHouses.forEach(h=>$("myHouses").append(makeItem(h.name,h.location+" · Bought "+new Date(h.purchased_at).toLocaleDateString(),"Owned",()=>{},true)))}
function renderChips(){$("locationChips").replaceChildren();places.forEach(p=>{const b=document.createElement("button");b.className="location-chip"+(p.name===user.location?" active":"");b.textContent=p.emoji+" "+p.name;b.onclick=()=>moveTo(p.name);$("locationChips").append(b)})}
function initMap(){if(!window.L){$("map").textContent="Map library could not load. Check your internet connection.";return}map=L.map("map").setView([6.49,3.39],12);L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",{maxZoom:19,attribution:'&copy; OpenStreetMap contributors'}).addTo(map);places.forEach(p=>{const marker=L.marker([p.lat,p.lng]).addTo(map).bindPopup(`<strong>${p.emoji} ${p.name}</strong><br><button onclick="moveTo('${p.name.replace(/'/g,"\\'")}')">Travel here</button>`);markers[p.name]=marker});setTimeout(()=>map.invalidateSize(),300)}
window.moveTo=async name=>{if(!places.some(p=>p.name===name))return;try{const r=await api("/api/location",{method:"POST",body:JSON.stringify({location:name})});user=r.user;renderProfile();renderChips();renderStats();if(socket&&socket.connected)socket.emit("world:move",name);$("mapNotice").textContent="You travelled to "+name+".";if(markers[name]){map.setView(markers[name].getLatLng(),14);markers[name].openPopup()}await refreshPresence();toast("Arrived in "+name)}catch(e){toast(e.message)}};
function connectSocket(){if(socket)socket.disconnect();socket=io({transports:["websocket","polling"]});socket.on("connect",()=>{$("connection").textContent="City connected";socket.emit("presence:hello")});socket.on("disconnect",()=>{$("connection").textContent="Reconnecting…"});socket.on("presence:list",renderPresence);socket.on("world:chat-message",m=>addChat(m,true));socket.on("private:message",m=>{if(selectedDm&&(m.sender_id===selectedDm||m.receiver_id===selectedDm))loadDm();if(m.receiver_id===user.id)toast("New private message")});socket.on("friends:update",renderFriends);socket.on("app:error",m=>toast(m));socket.on("account:removed",()=>{toast("Your account was removed by an admin.");setTimeout(()=>location.reload(),1000)})}
function renderPresence(list){if(!list)return;const old=$("onlineList");if(old)old.remove();const sec=document.createElement("section");sec.id="onlineList";sec.className="panel";const h=document.createElement("div");h.className="head";h.innerHTML='<h2>Players online</h2><span class="tag">'+list.length+' ONLINE</span>';sec.append(h);const l=document.createElement("div");l.className="list";list.forEach(p=>{const item=document.createElement("div");item.className="item";const d=document.createElement("div");const strong=document.createElement("strong");strong.textContent=p.username+(p.id===user.id?" (you)":"");const small=document.createElement("small");small.textContent="📍 "+p.location+" · Player ID "+p.id;d.append(strong,small);const actions=document.createElement("div");actions.className="actions";if(p.id!==user.id){const report=document.createElement("button");report.className="btn";report.textContent="Report";report.onclick=()=>{$("reportUser").value=p.id;$("reportReason").focus()};const mute=document.createElement("button");mute.className="btn";mute.textContent=mutedIds.has(p.id)?"Muted":"Mute";mute.onclick=async()=>{try{await api("/api/mute/"+p.id,{method:"POST",body:"{}"});mutedIds.add(p.id);mute.textContent="Muted";toast("Muted for your view.")}catch(e){toast(e.message)}};actions.append(report,mute)}item.append(d,actions);l.append(item)});sec.append(l);const main=document.querySelector("main");main.append(sec)}
async function refreshPresence(){try{const d=await api("/api/world");renderPresence(d.online)}catch{}}
function addChat(m,scroll=true){if(!m||mutedIds.has(m.user_id))return;const row=document.createElement("div");row.className="msg";const name=document.createElement("strong");name.textContent=(m.username||"Player")+": ";const body=document.createElement("span");body.textContent=m.body;const time=document.createElement("small");time.textContent=new Date(m.created_at).toLocaleTimeString([],{hour:"2-digit",minute:"2-digit"});row.append(name,body,time);$("chatbox").append(row);while($("chatbox").children.length>100)$("chatbox").firstElementChild.remove();if(scroll)$("chatbox").scrollTop=$("chatbox").scrollHeight}
$("chatForm").onsubmit=e=>{e.preventDefault();const body=$("chatInput").value.trim();if(body&&socket&&socket.connected){socket.emit("world:chat",body);$("chatInput").value=""}};
async function renderFriends(){try{const data=await api("/api/friends");friends=data.friends;$("friendsList").replaceChildren();$("dmFriend").replaceChildren(new Option("Choose a friend",""));friends.forEach(f=>{const isRequester=f.requester_id===f.id;const accepted=f.status==="accepted";const incoming=f.status==="pending"&&f.requester_id!==user.id;const row=document.createElement("div");row.className="item";const d=document.createElement("div");const strong=document.createElement("strong");strong.textContent=f.username;const sm=document.createElement("small");sm.textContent=accepted?"Friend":incoming?"Incoming request":"Request pending";d.append(strong,sm);row.append(d);if(incoming){const b=document.createElement("button");b.className="btn primary";b.textContent="Accept";b.onclick=async()=>{try{await api(`/api/friends/${f.id}/accept`,{method:"POST",body:"{}"});renderFriends()}catch(e){toast(e.message)}};row.append(b)}else if(accepted){$("dmFriend").add(new Option(f.username,f.id));const b=document.createElement("button");b.className="btn";b.textContent="Message";b.onclick=()=>{$("dmFriend").value=f.id;document.querySelector('[data-tab="dmView"]').click();loadDm()};row.append(b)}$("friendsList").append(row)});if(!friends.length)$("friendsList").innerHTML='<div class="muted">No friends yet. Add a username to send a request.</div>'}catch(e){toast(e.message)}}
$("friendForm").onsubmit=async e=>{e.preventDefault();try{const r=await api("/api/friends/request",{method:"POST",body:JSON.stringify({username:$("friendName").value.trim()})});$("friendNotice").textContent=r.message;$("friendName").value="";renderFriends()}catch(err){$("friendNotice").textContent=err.message}};
document.querySelectorAll(".tab").forEach(b=>b.onclick=()=>{document.querySelectorAll(".tab").forEach(x=>x.classList.toggle("active",x===b));$("friendsView").classList.toggle("hidden",b.dataset.tab!=="friendsView");$("dmView").classList.toggle("hidden",b.dataset.tab!=="dmView")});
$("dmFriend").onchange=()=>{selectedDm=Number($("dmFriend").value)||null;loadDm()};
async function loadDm(){if(!selectedDm){$("dmBox").replaceChildren();return}try{const r=await api("/api/messages/"+selectedDm);$("dmBox").replaceChildren();r.messages.forEach(m=>{const row=document.createElement("div");row.className="msg";const strong=document.createElement("strong");strong.textContent=(m.sender_id===user.id?"You":"Friend")+": ";const body=document.createElement("span");body.textContent=m.body;row.append(strong,body);$("dmBox").append(row)});$("dmBox").scrollTop=$("dmBox").scrollHeight}catch(e){$("dmNotice").textContent=e.message}}
$("dmForm").onsubmit=e=>{e.preventDefault();const body=$("dmInput").value.trim();if(!selectedDm)return $("dmNotice").textContent="Choose a friend first.";if(body&&socket){socket.emit("private:send",{to:selectedDm,body});$("dmInput").value=""}};
$("reportForm").onsubmit=async e=>{e.preventDefault();try{const r=await api("/api/report",{method:"POST",body:JSON.stringify({userId:Number($("reportUser").value),reason:$("reportReason").value.trim()})});$("reportNotice").textContent=r.message;$("reportReason").value="";if(user.role==="admin")loadReports()}catch(err){$("reportNotice").textContent=err.message}};
async function loadReports(){try{const r=await api("/api/admin/reports");$("reportsList").replaceChildren();r.reports.forEach(x=>{const row=makeSimpleReport(x);$("reportsList").append(row)})}catch(e){toast(e.message)}}
function makeSimpleReport(r){const row=document.createElement("div");row.className="item";const d=document.createElement("div");const strong=document.createElement("strong");strong.textContent="#"+r.id+" · "+r.reported;const sm=document.createElement("small");sm.textContent="By "+r.reporter+" · "+r.status+" · "+r.reason;d.append(strong,sm);const select=document.createElement("select");select.className="field";["open","reviewed","dismissed"].forEach(s=>select.add(new Option(s,s)));select.value=r.status;select.onchange=async()=>{try{await api("/api/admin/reports/"+r.id+"/status",{method:"POST",body:JSON.stringify({status:select.value})});toast("Report status updated")}catch(e){toast(e.message)}};const del=document.createElement("button");del.className="btn danger";del.textContent="Delete player";del.onclick=async()=>{if(!confirm("Permanently delete this reported player's account and saved data?"))return;try{await api("/api/admin/users/"+r.reported_id+"/ban",{method:"POST",body:"{}"});toast("Player deleted");loadReports()}catch(e){toast(e.message)}};const actions=document.createElement("div");actions.className="actions";actions.append(select,del);row.append(d,actions);return row}
async function start(){try{const d=await api("/api/me");user=d.user;$("authOverlay").classList.add("hidden");$("logoutBtn").hidden=false;if(user.role==="admin"){$("adminPanel").classList.remove("hidden");loadReports()}await loadWorld();connectSocket();initMap()}catch{setAuth(false)}}
start();
</script></body></html>
